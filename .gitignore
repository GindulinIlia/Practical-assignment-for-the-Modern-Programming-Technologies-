# Игнорируем файлы и папки, специфичные для Android и Android Studio

# Скомпилированные файлы приложений
*.apk
*.ap_
*.aab

# Файлы виртуальной машины (Dalvik/ART)
*.dex

# Java class files
*.class

# Сгенерированные файлы
bin/
gen/
out/
#  (вывод NDK)
obj/

# Файлы конфигурации и сборки Gradle
.gradle/
build/
captures/

# Локальная конфигурация (ПУТИ К SDK, не коммитить!)
local.properties

# Файлы Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Внешние инструменты сборки
.externalNativeBuild/
.cxx/

# Файлы подписи (никогда не коммитьте ключи!)
*.jks
*.keystore

# Системные файлы
.DS_Store
Thumbs.db

# Файлы логов
*.log

# Google Services (раскомментируйте, если не хотите коммитить конфигурацию Firebase)
# google-services.json